{
  "name": "@endix-demo/bots-runtime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bots": "tsx src/cli/bots.ts",
    "checker": "tsx src/cli/checker.ts",
    "replay": "tsx src/cli/replay.ts",
    "logs": "tsx src/cli/logs.ts",
    "check": "tsc --noEmit && vitest run",
    "eval:lighthouse": "tsx evals/lighthouse/run.ts",
    "eval:question-idea": "tsx evals/question-idea/run.ts",
    "evals": "npm run eval:lighthouse; a=$?; npm run eval:question-idea; b=$?; test $a -eq 0 && test $b -eq 0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@anthropic-ai/sdk": "0.129.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@notionhq/client": "5.27.0",
    "@slack/bolt": "5.1.0",
    "@slack/web-api": "8.1.1",
    "dotenv": "18.0.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
